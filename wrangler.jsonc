{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "imprenta",
    "main": "src/worker/index.js",
    "compatibility_date": "2026-09-01",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application", // Unknown paths get index.html.
        "run_worker_first": ["/api/*"] // Only API calls run the Worker code; everything else is a plain static file.
    },
    "kv_namespaces": [
        { "binding": "USERS", "id": "f2eb23d360c64dffae6e285fc50d8fe3" }
    ],
    "vars": {
        "GITHUB_API": "https://api.github.com"
    }
}
